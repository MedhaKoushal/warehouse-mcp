# ==========================================
# SellerOS Warehouse MCP - .gitignore
# ==========================================

# --- Local Secrets, Credentials & Configs ---
# Prevent accidental leaks of AWS credentials, RDS passwords, and Apify tokens
config.json
config.local.json
*.local.json
!config.example.json
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- PyInstaller & Distribution / Packaging ---
build/
dist/
*.spec
*.manifest
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Testing, Coverage & Quality Tools ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.cache
.mypy_cache/
.ruff_cache/
nosetests.xml
coverage.xml
*.cover
*.py.cache

# --- IDEs & Editors ---
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- Logs & Temporary Files ---
*.log
logs/
pip-log.txt
pip-delete-this-directory.txt
*.sqlite3
*.db
tmp/
temp/

# --- AI Agents & Workspace Tooling ---
.gemini/
.agents/
.claude/

# --- Operating System Files ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
